{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "environment": "development",
  "required": ["NODE_ENV", "SOLE_ENVIRONMENT", "SOLE_SITE_URL"],
  "allowed": ["NODE_ENV", "SOLE_ENVIRONMENT", "SOLE_SITE_URL", "SOLE_API_URL", "SOLE_RELEASE_SHA"],
  "constraints": {
    "NODE_ENV": "development",
    "SOLE_ENVIRONMENT": "development"
  },
  "forbiddenValuePattern": "(?i)(replace-me|changeme|example-secret)"
}
