{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "environment": "preview",
  "required": ["NODE_ENV", "SOLE_ENVIRONMENT", "SOLE_SITE_URL", "SOLE_RELEASE_SHA"],
  "allowed": ["NODE_ENV", "SOLE_ENVIRONMENT", "SOLE_SITE_URL", "SOLE_API_URL", "SOLE_RELEASE_SHA"],
  "constraints": {
    "NODE_ENV": "production",
    "SOLE_ENVIRONMENT": "preview"
