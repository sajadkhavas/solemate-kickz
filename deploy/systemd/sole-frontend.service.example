[Unit]
Description=SOLE TanStack Start frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sole
Group=sole
WorkingDirectory=/var/www/sole/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4173
EnvironmentFile=/var/www/sole/shared/env/production.env
ExecStart=/var/www/sole/current/.runtime/node/bin/node /var/www/sole/current/.output/server/index.mjs
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGTERM
KillMode=control-group
UMask=0027
CPUQuota=70%
CPUWeight=20
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=512M
TasksMax=128
LimitNOFILE=65535
Nice=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
