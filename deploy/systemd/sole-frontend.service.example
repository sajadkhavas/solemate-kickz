[Unit]
Description=SOLE frontend Node server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sole
Group=sole
WorkingDirectory=/var/www/sole/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=NITRO_HOST=127.0.0.1
Environment=PORT=4173
Environment=NITRO_PORT=4173
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/var/www/sole/current/.runtime/node/bin/node .output/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
KillMode=control-group

CPUQuota=70%
CPUWeight=20
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=512M
TasksMax=128
LimitNOFILE=65535
Nice=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
